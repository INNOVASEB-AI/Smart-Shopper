# Smart Shopper SA - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================

# Firebase Project ID
FIREBASE_PROJECT_ID=smart-shopper-46f4c

# Firebase Service Account (for backend operations)
# This should be the full JSON content of your service account key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"smart-shopper-46f4c",...}

# Firebase Web API Key (for frontend)
FIREBASE_API_KEY=AIzaSyDncAfsheDy_-dxIxl45rgBVFVUqA_BUM4

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=smart-shopper-46f4c.firebaseapp.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=smart-shopper-46f4c.firebasestorage.app

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=227443313787

# Firebase App ID
FIREBASE_APP_ID=1:227443313787:web:f7d0fb52c88e14254966de

# =============================================================================
# FIRECRAWL CONFIGURATION
# =============================================================================

# Firecrawl API Key (for web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Firecrawl Rate Limit (requests per minute)
FIRECRAWL_RATE_LIMIT=60

# =============================================================================
# DATA SOURCE CONFIGURATION
# =============================================================================

# Enable/disable data sources (true/false)
USE_FIREBASE=true
USE_DATABASE=true
USE_JSON=false
USE_FIRECRAWL=true

# Database path (SQLite)
DATABASE_PATH=./scrapers/crawl4ai_scrapers/data/products.db

# JSON data file path (fallback)
JSON_DATA_PATH=./data/products.json

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server port
PORT=3001

# Environment (development/production)
NODE_ENV=development

# Log level (debug/info/warn/error)
LOG_LEVEL=info

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://smart-shopper-46f4c.web.app

# =============================================================================
# CRAWLER CONFIGURATION
# =============================================================================

# Maximum products per retailer
MAX_PRODUCTS_PER_RETAILER=200

# Crawl delay between requests (seconds)
CRAWL_DELAY=1

# Retry attempts for failed requests
RETRY_ATTEMPTS=3

# =============================================================================
# PRICE HISTORY CONFIGURATION
# =============================================================================

# Enable price history tracking
ENABLE_PRICE_HISTORY=true

# Maximum price history entries per product
MAX_PRICE_HISTORY_ENTRIES=30

# Price change threshold for notifications (%)
PRICE_CHANGE_THRESHOLD=5.0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_here

# API Rate limiting
API_RATE_LIMIT=100

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Enable detailed logging
ENABLE_DETAILED_LOGGING=true

# Report generation interval (hours)
REPORT_INTERVAL=24

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=your_email@gmail.com 