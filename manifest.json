        }
      ]
    },
    {
      "name": "Shopping List",
      "short_name": "List",
      "description": "View your shopping list",
      "url": "/?action=list",
      "icons": [
        {
          "src": "/icons/list-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Loyalty Cards",
      "short_name": "Cards",
